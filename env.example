# Token libre que vos elegís — tiene que coincidir con el que configurás en el webhook de Meta
WEBHOOK_VERIFY_TOKEN=vacker_webhook_2024

# ── Asesor ───────────────────────────────────────────────────────────────────
# Número de WhatsApp del asesor (sin + ni espacios)
ASESOR_WHATSAPP=5493413015966
# Email Google Calendar del asesor
GCAL_EMAIL=ezequiel@vacker.com.ar

# ── Horario para mensajes automáticos (hora Argentina) ────────────────────────
