# ── Claude ────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
# Opcional (por defecto: claude-sonnet-4-6)
ANTHROPIC_MODEL=

# ── WhatsApp ──────────────────────────────────────────────────────────────────
# Proveedor: kapso (línea de Pablo, con coexistencia) o meta (número de prueba de Meta).
WHATSAPP_PROVIDER=meta

# Kapso: API key del proyecto, phone_number_id del número de Pablo y el secreto
# del webhook de tipo "meta" (el número de Pablo tiene que estar solo en su proyecto:
# la agenda se lee de todos los contactos del proyecto).
KAPSO_API_KEY=
KAPSO_PHONE_NUMBER_ID=
KAPSO_WEBHOOK_SECRET=

# Meta directo (número de prueba)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
# Obligatorio: sin esto el webhook rechaza todos los mensajes
WHATSAPP_APP_SECRET=
# 1 = no envía nada, solo loguea (pruebas locales)
WHATSAPP_DRY_RUN=

# ── Modo observación ──────────────────────────────────────────────────────────
# Por defecto el agente NO responde: solo registra qué decidiría el filtro.
# Poner "false" para que empiece a responderles a los leads.
MODO_OBSERVACION=

# ── Tokko (carga de la consulta al derivar un lead de anuncio) ────────────────
TOKKO_API_KEY=

# ── Administración ────────────────────────────────────────────────────────────
# Token para /api/* (header "Authorization: Bearer ..."). Sin esto responden 401.
ADMIN_TOKEN=

# ── Datos ─────────────────────────────────────────────────────────────────────
# En Railway: montar un volumen y dejar DB_PATH vacío
# (usa $RAILWAY_VOLUME_MOUNT_PATH/vacker.sqlite). Local: ./data/vacker.sqlite
DB_PATH=

PORT=3000
